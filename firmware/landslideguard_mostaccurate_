}

void setRGB(bool red, bool green, bool blue) {
  digitalWrite(LED_R, red ? HIGH : LOW);
  digitalWrite(LED_G, green ? HIGH : LOW);
  digitalWrite(LED_B, blue ? HIGH : LOW);
}

const char* riskName(int value) {
  switch (value) {
    case 0: return "CRITICAL";
    case 1: return "HIGH";
    case 2: return "LOW";
    case 3: return "MODERATE";
    default: return "N/A";
  }
}

// =====================================
// MPU6050
// =====================================

bool writeMPU(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(value);
  return Wire.endTransmission() == 0;
}

bool readMPU(float &angle, float &deviationG) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);

  if (Wire.endTransmission(false) != 0)
    return false;

  if (Wire.requestFrom((int)MPU_ADDR, 14, true) != 14)
    return false;

  int16_t axRaw =
    (int16_t)((Wire.read() << 8) | Wire.read());

  int16_t ayRaw =
    (int16_t)((Wire.read() << 8) | Wire.read());

  int16_t azRaw =
    (int16_t)((Wire.read() << 8) | Wire.read());

  for (int i = 0; i < 8; i++)
    Wire.read();

  float ax = axRaw / 16384.0f;
  float ay = ayRaw / 16384.0f;
  float az = azRaw / 16384.0f;

  angle = atan2f(
    ax,
    sqrtf(ay * ay + az * az)
  ) * 57.2957795f;

  float magnitude = sqrtf(
    ax * ax + ay * ay + az * az
  );

  deviationG = fabsf(magnitude - 1.0f);

  return isfinite(angle) && isfinite(deviationG);
}

void sampleMPU() {
  unsigned long now = millis();

  if (now - lastMPUSample < MPU_INTERVAL)
    return;

  lastMPUSample = now;

  float angle = 0;
  float deviation = 0;

  mpuSampleValid =
    mpuReady && readMPU(angle, deviation);

  if (!mpuSampleValid)
    return;

  currentTilt = angle;

  if (!baselineReady) {
    baselineSum += angle;
    baselineSamples++;

    if (baselineSamples >= 100) {
      baselineTilt =
        baselineSum / baselineSamples;

      baselineReady = true;

      Serial.print("MPU baseline: ");
      Serial.println(baselineTilt, 2);
    }

    return;
  }

  if (deviation > vibrationPeak)
    vibrationPeak = deviation;
}

// =====================================
// ADS1115 MOISTURE
// =====================================

float readMedianADC(uint8_t channel) {
  int16_t samples[5];

  for (int i = 0; i < 5; i++) {
    samples[i] =
      ads.readADC_SingleEnded(channel);
    delay(3);
  }

  for (int i = 1; i < 5; i++) {
    int16_t key = samples[i];
    int j = i - 1;

    while (j >= 0 && samples[j] > key) {
      samples[j + 1] = samples[j];
      j--;
    }

    samples[j + 1] = key;
  }

  return (float)samples[2];
}

float calculateMoisture(float raw, int index) {
  float denominator =
    DRY_ADC[index] - WET_ADC[index];

  if (!isfinite(raw) || denominator <= 0)
    return NAN;

  float percent =
    100.0f *
    (DRY_ADC[index] - raw) /
    denominator;

  return constrain(percent, 0.0f, 100.0f);
}

void updateMoisture() {
  moistureDisplayReady = false;
  moistureValid = false;
  lowSignalWarning = false;

  if (!adsReady) {
    averageMoisture = NAN;
    moistureRange = NAN;

    for (int i = 0; i < 3; i++) {
      rawADC[i] = NAN;
      filteredADC[i] = NAN;
      moisture[i] = NAN;
      filterReady[i] = false;
    }

    goodFrames = 0;
    wetFrames = 0;
    moistureAlarm = false;
    return;
  }

  bool readingsUsable = true;

  for (int i = 0; i < 3; i++) {
    rawADC[i] = readMedianADC(i);

    if (
      !isfinite(rawADC[i]) ||
      rawADC[i] < 0 ||
      rawADC[i] > ADC_MAX_VALID
    ) {
      readingsUsable = false;
    }

    if (
      isfinite(rawADC[i]) &&
      rawADC[i] >= 0 &&
      rawADC[i] < ADC_LOW_SIGNAL
    ) {
      lowSignalWarning = true;
    }
  }

  if (!readingsUsable) {
    averageMoisture = NAN;
    moistureRange = NAN;

    for (int i = 0; i < 3; i++) {
      moisture[i] = NAN;
      filterReady[i] = false;
    }

    goodFrames = 0;
    wetFrames = 0;
    moistureAlarm = false;
    return;
  }

  float sum = 0;
  float minimum = 100;
  float maximum = 0;

  for (int i = 0; i < 3; i++) {
    if (
      !filterReady[i] ||
      !isfinite(filteredADC[i]) ||
      fabsf(rawADC[i] - filteredADC[i]) > 3500
    ) {
      filteredADC[i] = rawADC[i];
      filterReady[i] = true;
    } else {
      filteredADC[i] =
        0.65f * filteredADC[i] +
        0.35f * rawADC[i];
    }

    moisture[i] =
      calculateMoisture(filteredADC[i], i);

    if (!isfinite(moisture[i])) {
      readingsUsable = false;
      break;
    }

    sum += moisture[i];

    if (moisture[i] < minimum)
      minimum = moisture[i];

    if (moisture[i] > maximum)
      maximum = moisture[i];
  }

  if (!readingsUsable) {
    averageMoisture = NAN;
    moistureRange = NAN;
    goodFrames = 0;
    wetFrames = 0;
    moistureAlarm = false;
    return;
  }

  averageMoisture = sum / 3.0f;
  moistureRange = maximum - minimum;
  moistureDisplayReady = true;

  if (lowSignalWarning) {
    goodFrames = 0;
    moistureValid = false;
  } else {
    goodFrames++;
    moistureValid =
      goodFrames >= RECOVERY_FRAMES;
  }

  if (!moistureValid) {
    wetFrames = 0;
    moistureAlarm = false;
    return;
  }

  if (!moistureAlarm) {
    if (averageMoisture >= MOISTURE_ON)
      wetFrames++;
    else
      wetFrames = 0;

    if (wetFrames >= ALARM_CONFIRM_FRAMES)
      moistureAlarm = true;
  } else {
    if (averageMoisture < MOISTURE_OFF) {
      moistureAlarm = false;
      wetFrames = 0;
    }
  }
}

// =====================================
// VL53L0X DISPLACEMENT
// =====================================

void updateToF() {
  tofDistance = NAN;
  displacement = NAN;

  if (!tofReady)
    return;

  VL53L0X_RangingMeasurementData_t measurement;
  tof.rangingTest(&measurement, false);

  if (
    measurement.RangeStatus != 0 ||
    measurement.RangeMilliMeter == 0
  ) {
    return;
  }

  tofDistance = measurement.RangeMilliMeter;

  if (!tofBaselineReady) {
    tofBaseline = tofDistance;
    tofBaselineReady = true;
  }

  displacement = tofDistance - tofBaseline;
}

// =====================================
// TINYML INFERENCE
// =====================================

void updatePrediction() {
  prediction = -1;

  bool modelReady =
    moistureValid &&
    baselineReady &&
    mpuSampleValid &&
    isfinite(displacement);

  if (!modelReady) {
    previousValid = false;
    return;
  }

  unsigned long now = millis();

  float dt = previousReport
    ? (now - previousReport) / 1000.0f
    : 0;

  float moistureRate = 0;
  float tiltRate = 0;
  float displacementRate = 0;
  float vibrationRate = 0;

  if (previousValid && dt > 0) {
    moistureRate =
      (averageMoisture - previousMoisture) / dt;

    tiltRate =
      (currentTilt - previousTilt) / dt;

    displacementRate =
      (displacement - previousDisplacement) / dt;

    vibrationRate =
      (vibration - previousVibration) / dt;
  }

  // Existing model's 11-feature interface.
  // Rainfall fields are placeholders.
  float features[11] = {
    5.0f,
    averageMoisture,
    moistureRange,
    fabsf(currentTilt),
    fabsf(displacement),
    vibration,
    moistureRate,
    tiltRate,
    displacementRate,
    vibrationRate,
    0.0f
  };

  prediction = model.predict(features);

  previousMoisture = averageMoisture;
  previousTilt = currentTilt;
  previousDisplacement = displacement;
  previousVibration = vibration;

  previousValid = true;
}

// =====================================
// NEW SLOPE MOVEMENT LOGIC
// =====================================

int getMovementLevel() {
  if (!baselineReady || !mpuSampleValid) {
    slopeAngle = NAN;
    return 0;
  }

  tiltChange =
    fabsf(currentTilt - baselineTilt);

  // Startup slope assumed to be 52.5 degrees.
  // This is an estimated physical slope angle.
  slopeAngle =
    SLOPE_REST_DEG +
    (currentTilt - baselineTilt);

  float outsideBand = 0;

  if (slopeAngle < SLOPE_NORMAL_MIN_DEG) {
    outsideBand =
      SLOPE_NORMAL_MIN_DEG - slopeAngle;
  } else if (
    slopeAngle > SLOPE_NORMAL_MAX_DEG
  ) {
    outsideBand =
      slopeAngle - SLOPE_NORMAL_MAX_DEG;
  }

  int tiltLevel = 0;

  if (outsideBand >= SLOPE_HIGH_EXCESS_DEG) {
    tiltLevel = 2;
  } else if (outsideBand > 0) {
    tiltLevel = 1;
  }

  int vibrationLevel = 0;

  if (vibration >= VIB_HIGH_G) {
    vibrationLevel = 2;
  } else if (vibration >= VIB_WARNING_G) {
    vibrationLevel = 1;
  }

  if (vibrationLevel > 0) {
    vibrationHeldLevel =
      max(vibrationHeldLevel, vibrationLevel);

    lastVibrationEvent = millis();
  }

  if (
    millis() - lastVibrationEvent >=
    VIB_HOLD_TIME
  ) {
    vibrationHeldLevel = 0;
  }

  return max(tiltLevel, vibrationHeldLevel);
}

// =====================================
// STATUS
// =====================================

const char* getStatus(int movementLevel) {
  if (!moistureDisplayReady)
    return "MOISTURE READ ERROR";

  // A genuine high-moisture condition should
  // still take priority over the low-ADC flag.
  if (
    isfinite(averageMoisture) &&
    averageMoisture >= MOISTURE_ON
  ) {
    return "HIGH MOISTURE ALERT";
  }

  if (lowSignalWarning)
    return "LOW ADC SIGNAL";

  if (!moistureValid)
    return "SENSOR STABILIZING";

  if (moistureAlarm)
    return "HIGH MOISTURE ALERT";

  if (!baselineReady)
    return "CALIBRATING MPU";

  if (!mpuSampleValid)
    return "MPU SENSOR FAULT";

  if (prediction == 0)
    return "ML CRITICAL";

  if (prediction == 1)
    return "ML HIGH RISK";

  if (movementLevel == 2)
    return "SLOPE MOVEMENT";

  if (movementLevel == 1)
    return "MOVEMENT WARNING";

  if (prediction == 3)
    return "ML MODERATE";

  return "SYSTEM NORMAL";
}

// =====================================
// RGB AND BUZZER
// =====================================

void updateOutputs(int movementLevel) {
  bool highMoisture =
    moistureDisplayReady &&
    isfinite(averageMoisture) &&
    averageMoisture >= 95.0f;

  // Buzzer activates even if raw ADC < 1500.
  setBuzzer(highMoisture);

  if (highMoisture) {
    setRGB(true, false, false);
  } else if (!moistureValid) {
    setRGB(false, false, true);
  } else if (
    movementLevel == 2 ||
    prediction == 0 ||
    prediction == 1
  ) {
    setRGB(true, false, false);
  } else if (
    movementLevel == 1 ||
    prediction == 3
  ) {
    setRGB(true, true, false);
  } else {
    setRGB(false, true, false);
  }
}

