  if (!oledReady)
    return;

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.setCursor(0, 0);
  display.print("LANDSLIDEGUARD");

  display.setCursor(108, 0);
  display.print("LG");

  display.drawLine(
    0, 10, 127, 10, SSD1306_WHITE
  );

  display.setCursor(0, 14);
  display.print("MOISTURE ");

  if (moistureDisplayReady) {
    display.print(averageMoisture, 1);
    display.print("%");

    if (!moistureValid)
      display.print("*");
  } else {
    display.print("N/A");
  }

  display.setCursor(0, 24);
  display.print("SLOPE    ");

  if (
    baselineReady &&
    mpuSampleValid &&
    isfinite(slopeAngle)
  ) {
    display.print(slopeAngle, 1);
    display.print(" deg");
  } else {
    display.print("CAL / N/A");
  }

  display.setCursor(0, 34);
  display.print("DISPLACE ");

  if (isfinite(displacement)) {
    display.print(displacement, 0);
    display.print(" mm");
  } else {
    display.print("N/A");
  }

  display.setCursor(0, 44);
  display.print("TINYML   ");
  display.print(riskName(prediction));

  display.fillRect(
    0, 54, 128, 10, SSD1306_WHITE
  );

  display.setTextColor(SSD1306_BLACK);
  display.setCursor(2, 55);

  // Shorten messages for the 128px OLED.
  if (strcmp(status, "HIGH MOISTURE ALERT") == 0) {
    display.print("HIGH MOISTURE");
  } else if (
    strcmp(status, "SENSOR STABILIZING") == 0
  ) {
    display.print("STABILIZING");
  } else if (
    strcmp(status, "CALIBRATING MPU") == 0
  ) {
    display.print("CALIBRATING");
  } else if (
    strcmp(status, "MOVEMENT WARNING") == 0
  ) {
    display.print("MOVEMENT WARN");
  } else if (
    strcmp(status, "SLOPE MOVEMENT") == 0
  ) {
    display.print("SLOPE MOVEMENT");
  } else if (
    strcmp(status, "SYSTEM NORMAL") == 0
  ) {
    display.print("SYSTEM NORMAL");
  } else {
    display.print(status);
  }

  display.display();
}

