void setBuzzer(bool on) {
  buzzerState = on;

  digitalWrite(
    BUZZER_PIN,
    on
      ? (BUZZER_ACTIVE_HIGH ? HIGH : LOW)
      : (BUZZER_ACTIVE_HIGH ? LOW : HIGH)
