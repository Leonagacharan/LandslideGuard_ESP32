  display.setCursor(2, 55);

  if (!moistureDisplayReady) {
    display.print("MOISTURE READ ERROR");
  } else if (lowSignalWarning) {
    display.print("LOW ADC - CHECK");
  } else if (!moistureValid) {
    display.print("STABILIZING...");
  } else if (moistureAlarm) {
    display.print("HIGH MOISTURE ALERT");
  } else if (!baselineReady) {
    display.print("CALIBRATING...");
  } else if (!mpuSampleValid) {
    display.print("MPU SENSOR FAULT");
  } else if (tiltChange >= TILT_HIGH_DEG) {
    display.print("TILT ALERT");
  } else if (tiltChange >= TILT_WARNING_DEG) {
    display.print("TILT WARNING");
  } else if (vibrationHeldLevel > 0) {
    display.print("VIBRATION DETECTED");
  } else if (prediction == 0) {
    display.print("ML CRITICAL RISK");
  } else if (prediction == 1) {
    display.print("ML HIGH RISK");
  } else {
    display.print("MONITORING ACTIVE");
  }

  display.display();
