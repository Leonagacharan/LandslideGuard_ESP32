// ==========================================
// WIFI AND MQTT
// ==========================================

void startWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  lastWifiAttempt = millis();

  Serial.println("Wi-Fi: attempting hotspot connection...");
}

void maintainNetwork() {
  unsigned long now = millis();

  if (WiFi.status() != WL_CONNECTED) {
    if (
      now - lastWifiAttempt >= NETWORK_RETRY_MS
    ) {
      lastWifiAttempt = now;
      WiFi.disconnect();
      WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
      Serial.println("Wi-Fi: retrying...");
    }
    return;
  }

  if (!mqttClient.connected()) {
    if (
      now - lastMqttAttempt >= NETWORK_RETRY_MS
    ) {
      lastMqttAttempt = now;

      String clientId =
        "LandslideGuard-" + WiFi.macAddress();

      clientId.replace(":", "");

      Serial.print("MQTT: connecting to ");
      Serial.print(MQTT_HOST);
      Serial.print(":");
      Serial.println(MQTT_PORT);

      if (
        mqttClient.connect(
          clientId.c_str(),
          MQTT_USER,
          MQTT_PASSWORD
        )
      ) {
        Serial.println("MQTT: CONNECTED");
      } else {
        Serial.print("MQTT: failed, state=");
        Serial.println(mqttClient.state());
      }
    }
    return;
  }

  mqttClient.loop();
}

void appendJsonFloat(
  String &payload,
  const char* key,
  float value,
  int decimals,
  bool comma = true
) {
  payload += "\"";
  payload += key;
  payload += "\":";

  if (isfinite(value)) {
    payload += String(value, decimals);
  } else {
    payload += "null";
  }

  if (comma) {
    payload += ",";
  }
}

void publishTelemetry(
  const char* status,
  int movementLevel
) {
  if (!mqttClient.connected()) {
    return;
  }

  String payload;
  payload.reserve(768);

  payload += "{";
  payload += "\"device\":\"LandslideGuard_ESP32\",";
  payload += "\"station\":\"station01\",";
  payload += "\"uptime_ms\":";
  payload += String(millis());
  payload += ",";

  appendJsonFloat(
    payload, "moisture1", moisture[0], 2
  );
  appendJsonFloat(
    payload, "moisture2", moisture[1], 2
  );
  appendJsonFloat(
    payload, "moisture3", moisture[2], 2
  );
  appendJsonFloat(
    payload, "average_moisture",
    averageMoisture, 2
  );
  appendJsonFloat(
    payload, "moisture_range",
    moistureRange, 2
  );
  appendJsonFloat(
    payload, "tilt",
    tiltChange, 2
  );
  appendJsonFloat(
    payload, "vibration",
    vibration, 4
  );
  appendJsonFloat(
    payload, "displacement",
    displacement, 2
  );
  appendJsonFloat(
    payload, "tof_distance",
    tofDistance, 2
  );

  payload += "\"risk\":\"";
  payload += riskName(prediction);
  payload += "\",";

  payload += "\"risk_code\":";
  payload += String(prediction);
  payload += ",";

  payload += "\"movement_level\":";
  payload += String(movementLevel);
  payload += ",";

  payload += "\"moisture_valid\":";
  payload += moistureValid ? "true" : "false";
  payload += ",";

  payload += "\"low_adc_warning\":";
  payload += lowSignalWarning ? "true" : "false";
  payload += ",";

  payload += "\"moisture_alarm\":";
  payload += moistureAlarm ? "true" : "false";
  payload += ",";

  payload += "\"buzzer\":";
  payload += moistureAlarm ? "true" : "false";
  payload += ",";

  payload += "\"status\":\"";
  payload += status;
  payload += "\"";

  payload += "}";

  bool sent = mqttClient.publish(
    MQTT_TOPIC,
    payload.c_str()
  );

  if (sent) {
    Serial.println("MQTT: telemetry published");
  } else {
    Serial.println("MQTT: publish failed");
  }
}

// ==========================================
// SETUP
// ==========================================

void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(LED_R, OUTPUT);
  pinMode(LED_G, OUTPUT);
  pinMode(LED_B, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  setRGB(false, false, false);
  setBuzzer(false);

  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);

  // ADS1115
  adsReady = ads.begin(0x48);

  if (adsReady) {
    ads.setGain(GAIN_ONE);
  }

  // MPU6050
  mpuReady = writeMPU(0x6B, 0x00);

  if (mpuReady) {
    writeMPU(0x1C, 0x00);
    writeMPU(0x1B, 0x00);
  }

  // VL53L0X
  tofReady = tof.begin();

  // SPI OLED
  SPI.begin(
    OLED_SCK,
    -1,
    OLED_MOSI,
    OLED_CS
  );

  oledReady = display.begin(
    SSD1306_SWITCHCAPVCC
  );

  if (oledReady) {
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);

    display.setCursor(12, 14);
    display.println("LANDSLIDEGUARD");

    display.setCursor(16, 30);
    display.println("ESP32 + TinyML");

    display.setCursor(18, 46);
    display.println("INITIALIZING");

    display.display();
  }

  Serial.println();
  Serial.println(
    "LANDSLIDEGUARD EXHIBITION START"
  );

  Serial.print("ADS1115: ");
  Serial.println(adsReady ? "READY" : "FAILED");

  Serial.print("MPU6050: ");
  Serial.println(mpuReady ? "READY" : "FAILED");

  Serial.print("VL53L0X: ");
  Serial.println(tofReady ? "READY" : "FAILED");

  Serial.print("OLED: ");
  Serial.println(oledReady ? "READY" : "FAILED");

  Serial.println(
    "Keep MPU and ToF target stationary during startup."
  );

  // MQTT buffer for sensor JSON
  mqttClient.setServer(MQTT_HOST, MQTT_PORT);
  mqttClient.setBufferSize(1024);
  mqttClient.setKeepAlive(30);
  mqttClient.setSocketTimeout(2);

  startWiFi();

  delay(1000);
}

// ==========================================
// MAIN LOOP
// ==========================================

void loop() {
  sampleMPU();

  maintainNetwork();

  unsigned long now = millis();

  if (now - lastReport < REPORT_INTERVAL) {
    return;
  }

  lastReport = now;

  // 1. Moisture
  updateMoisture();

  // 2. MPU
  if (baselineReady && mpuSampleValid) {
    tiltChange = fabsf(
      currentTilt - baselineTilt
    );
  } else {
    tiltChange = 0;
  }

  vibration = vibrationPeak;
  vibrationPeak = 0;

  // 3. ToF
  updateToF();

  // 4. TinyML
  updatePrediction();

  // 5. Movement
  int movementLevel = getMovementLevel();

  // 6. Status
  const char* status =
    getStatus(movementLevel);

  // 7. Buzzer and RGB
  updateOutputs(movementLevel);

  // 8. OLED
  drawOLED(status);

  // 9. Serial
  printDiagnostics(status);

  // 10. MQTT
  publishTelemetry(status, movementLevel);

  previousReport = millis();
}
